<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.intent-as-a-service</groupId>
    <artifactId>intent-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Intent SDK Parent</name>
    <description>嵌入式 AI 意图 SDK：意图即服务（去聊天框），本地闭环执行，网关可组装</description>
    <url>https://github.com/intent-as-a-service/intent-sdk</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>intent-as-a-service</id>
            <name>intent-as-a-service</name>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/intent-as-a-service/intent-sdk.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/intent-as-a-service/intent-sdk.git</developerConnection>
        <url>https://github.com/intent-as-a-service/intent-sdk</url>
    </scm>

    <modules>
        <module>intent-protocol</module>
        <module>intent-sdk-core</module>
        <module>intent-sdk-pi</module>
        <module>intent-sdk-host</module>
        <module>intent-spring-boot-starter</module>
        <module>intent-sdk-gateway</module>
    </modules>

    <!--
        intent-sdk-pi（执行器：builtin-agent / skill / flow）依赖 dev.pi:pi-ai 与 dev.pi:pi-agent，
        而这两个制品没有发布到任何公共仓库。

        为了让 `git clone` 之后 `mvn install` 一定能成功、下游宿主也能解析 dev.pi 坐标，
        执行器所需的 pi 制品已作为本地包随仓库分发：

            libs/dev/pi/{pi-java-parent, pi-ai, pi-agent, pi-telemetry}/0.1.0-SNAPSHOT/

        构建时由下面的 vendor-pi profile（只在存在 libs/dev/pi 的根模块激活）把它们
        安装进本地 Maven 仓，因此不依赖中央仓上是否有 pi 制品。

        pi 的源码工程在：https://gitee.com/harvey_danny/pi-agent-java
        需要升级 pi 时，重新构建该工程并替换 libs/ 下的 jar 与 pom 即可。
    -->

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jackson.version>2.17.3</jackson.version>
        <junit.version>5.10.2</junit.version>
        <pi-ai.version>0.1.0-SNAPSHOT</pi-ai.version>
        <pi-agent.version>0.1.0-SNAPSHOT</pi-agent.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.dataformat</groupId>
                <artifactId>jackson-dataformat-yaml</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.pi</groupId>
                <artifactId>pi-ai</artifactId>
                <version>${pi-ai.version}</version>
            </dependency>
            <dependency>
                <groupId>dev.pi</groupId>
                <artifactId>pi-agent</artifactId>
                <version>${pi-agent.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.intent-as-a-service</groupId>
                <artifactId>intent-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.intent-as-a-service</groupId>
                <artifactId>intent-sdk-pi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.intent-as-a-service</groupId>
                <artifactId>intent-sdk-host</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.intent-as-a-service</groupId>
                <artifactId>intent-sdk-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>4.7.5</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- 制品发布：源码包 + 文档包随主包一起产出，便于集成方在 IDE 内直接看源码与 API 文档 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.3</version>
                <configuration>
                    <encoding>UTF-8</encoding>
                    <!-- 输出编码必须显式钉死 UTF-8：Linux runner 的默认 locale 常是 C/POSIX(ASCII)，
                         此时中文注释会在生成文档阶段报 "unmappable character"，而 Windows 本地因默认
                         编码能吃下中文而看不出来（本仓库确实踩过：CI 红、本地绿）。 -->
                    <docencoding>UTF-8</docencoding>
                    <charset>UTF-8</charset>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            仅在仓库根模块激活（只有根模块存在 libs/dev/pi）：
            把随仓库分发的 pi 制品安装到本地 Maven 仓，使本仓的 intent-sdk-pi
            以及下游宿主都能解析 dev.pi:* 坐标，无需任何公共仓库上有 pi。
        -->
        <profile>
            <id>vendor-pi</id>
            <activation>
                <file>
                    <exists>${basedir}/libs/dev/pi</exists>
                </file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-install-plugin</artifactId>
                        <version>3.1.2</version>
                        <executions>
                            <execution>
                                <id>install-pi-java-parent</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>install-file</goal>
                                </goals>
                                <configuration>
                                    <file>${basedir}/libs/dev/pi/pi-java-parent/0.1.0-SNAPSHOT/pi-java-parent-0.1.0-SNAPSHOT.pom</file>
                                    <groupId>dev.pi</groupId>
                                    <artifactId>pi-java-parent</artifactId>
                                    <version>0.1.0-SNAPSHOT</version>
                                    <packaging>pom</packaging>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-pi-ai</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>install-file</goal>
                                </goals>
                                <configuration>
                                    <file>${basedir}/libs/dev/pi/pi-ai/0.1.0-SNAPSHOT/pi-ai-0.1.0-SNAPSHOT.jar</file>
                                    <pomFile>${basedir}/libs/dev/pi/pi-ai/0.1.0-SNAPSHOT/pi-ai-0.1.0-SNAPSHOT.pom</pomFile>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-pi-agent</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>install-file</goal>
                                </goals>
                                <configuration>
                                    <file>${basedir}/libs/dev/pi/pi-agent/0.1.0-SNAPSHOT/pi-agent-0.1.0-SNAPSHOT.jar</file>
                                    <pomFile>${basedir}/libs/dev/pi/pi-agent/0.1.0-SNAPSHOT/pi-agent-0.1.0-SNAPSHOT.pom</pomFile>
                                </configuration>
                            </execution>
                            <execution>
                                <id>install-pi-telemetry</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>install-file</goal>
                                </goals>
                                <configuration>
                                    <file>${basedir}/libs/dev/pi/pi-telemetry/0.1.0-SNAPSHOT/pi-telemetry-0.1.0-SNAPSHOT.jar</file>
                                    <pomFile>${basedir}/libs/dev/pi/pi-telemetry/0.1.0-SNAPSHOT/pi-telemetry-0.1.0-SNAPSHOT.pom</pomFile>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- 发布到 Maven 中央仓库：mvn -Prelease deploy（需配置 gpg 与 distributionManagement） -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
