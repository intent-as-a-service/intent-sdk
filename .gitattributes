# 统一换行符与文本处理，避免 Windows/Linux 贡献者互相制造噪声 diff
* text=auto eol=lf

# 二进制文件不做文本处理
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.xdb  binary
*.jar  binary
*.zip  binary

# 明确语言标记（GitHub 统计与语法高亮）
*.java   text diff=java
*.yaml   text
*.yml    text
*.xml    text
*.md     text
*.sql    text

# 生成物不计入语言统计
target/**  linguist-generated
docs/**/*.svg linguist-generated
